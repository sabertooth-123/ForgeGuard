# TrueForge server URL. Defaults to local standalone mode if unset.
TRUEFORGE_BASE_URL=http://localhost:8790

# Model name as registered in TrueForge (Settings -> Models), format
# "<provider-name>/<model-name>". Only used by devagent's manual smoke-test
# scripts (devagent/src/phase*.ts) -- DevAgent's actual model is set on the saved
# agent itself via `npm run register-agent` (see devagent/src/agent.ts).
TRUEFORGE_MODEL=ollama-local/qwen2.5-agent

# Never put real credentials here or in any committed file. Model provider and
# sandbox provider API keys are configured directly in TrueForge's own Settings
# (UI or API) -- they live in TrueForge's local SQLite store, never in this repo.
# If a scenario needs a placeholder secret for testing, use an obviously-fake one,
# e.g. FG_FAKE_API_KEY_123 -- never a real value, even for local-only testing.
